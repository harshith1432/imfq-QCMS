{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://imfq-qcms.onrender.com/api/$1"
    },
    {
      "source": "/login",
      "destination": "/frontend/auth/login.html"
    },
    {
      "source": "/register",
      "destination": "/frontend/auth/register-org.html"
    },
    {
      "source": "/register-org",
      "destination": "/frontend/auth/register-org.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
