{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/login(.html)?",
      "dest": "frontend/auth/login.html"
    },
    {
      "src": "/register(.html)?",
      "dest": "frontend/auth/register-org.html"
    },
    {
      "src": "/register-org(.html)?",
      "dest": "frontend/auth/register-org.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
