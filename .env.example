# ==============================================================================
# QCMS Enterprise Configuration Reference (.env.example)
# ==============================================================================

# Application Environment
FLASK_ENV=development
SECRET_KEY=replace-with-secure-random-secret-key-32-chars-minimum
JWT_SECRET_KEY=replace-with-secure-jwt-secret-key-32-chars-minimum

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://qcms_user:qcms_password@localhost:5432/qcms_db

# ── Distributed Redis Cache & Celery Message Broker ──────────────────────
# Format: redis://[:password@]host:port/db_number OR rediss:// for SSL
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379/0
CELERY_BROKER_URL=redis://default:your-redis-password@your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:your-redis-password@your-redis-host:6379/1

# Production Security Enforcement (Fail-closed if Redis drops)
REQUIRE_REDIS_SECURITY=true

# ══════════════════════════════════════════════════════════════════════════════
# STORAGE SERVICE ARCHITECTURE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Supported Backends:
#   - supabase : Development / Testing (Private bucket 'ifqmqc')
#   - azure    : Production (Azure Blob Storage Container)
#   - local    : Local Disk / Testing Fallback
STORAGE_BACKEND=supabase

# ── Development: Supabase Storage Configuration ──────────────────────────────
# Bucket MUST remain PRIVATE. Credentials are used on the backend ONLY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=ifqmqc

# ── Production: Azure Blob Storage Configuration ─────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=qcms-uploads
AZURE_STORAGE_BLOB_URL=https://youraccount.blob.core.windows.net/qcms-uploads

# ── Local Disk Storage Configuration ─────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Email Notifications (Resend API)
RESEND_API_KEY=re_sample_api_key_placeholder
EMAIL_FROM=notifications@example.com
