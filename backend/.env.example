# QCMS Backend Environment Configuration Example
# Copy this file to backend/.env for local development

DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/ifqmmm
JWT_SECRET_KEY=your_jwt_secret_key_here
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
GOOGLE_API_KEY=your_google_api_key_here

SUPER_ADMIN_USERNAME=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your_superadmin_password_here

# ── Default Temporary & Initial Passwords ──────────────────────────────
DEFAULT_TEMP_PASSWORD=Welcome@123
DEFAULT_USER_PASSWORD=Welcome@123
DEFAULT_ADMIN_PASSWORD=Welcome@123


# ── Distributed Redis Cache & Celery Message Broker ──────────────────────
# Format: redis://[:password@]host:port/db_number OR rediss:// for SSL
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379/0
CELERY_BROKER_URL=redis://default:your-redis-password@your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:your-redis-password@your-redis-host:6379/1

# Production Security Enforcement (Fail-closed if Redis drops)
REQUIRE_REDIS_SECURITY=true

INTEGRATION_BASE_URL=http://localhost:5000
